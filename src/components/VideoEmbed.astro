---
/**
 * Demo video from `media[]`. Local or direct video files use <video>;
 * YouTube/Vimeo links use their privacy-friendly embeds; any other HTTPS page
 * becomes a clearly labelled external link (no guessing about the host).
 */
import Icon from './Icon.astro';

interface Props {
  src: string;
  title: string;
  caption?: string;
  poster?: string;
}

const { src, title, caption, poster } = Astro.props;

function embedFor(url: string): string | null {
  try {
    const u = new URL(url);
    const host = u.hostname.replace(/^www\./, '');
    if (host === 'youtu.be') return `https://www.youtube-nocookie.com/embed/${u.pathname.slice(1)}`;
    if (host === 'youtube.com' || host === 'm.youtube.com') {
      if (u.pathname.startsWith('/embed/')) return `https://www.youtube-nocookie.com${u.pathname}`;
      if (u.pathname.startsWith('/shorts/')) return `https://www.youtube-nocookie.com/embed/${u.pathname.split('/')[2]}`;
      const id = u.searchParams.get('v');
      if (id) return `https://www.youtube-nocookie.com/embed/${id}`;
    }
    if (host === 'vimeo.com' && /^\/\d+/.test(u.pathname)) return `https://player.vimeo.com/video${u.pathname}`;
    if (host === 'player.vimeo.com') return url;
  } catch {
    return null;
  }
  return null;
}

const isLocal = src.startsWith('/');
const isFile = /\.(mp4|webm|mov|m4v|ogv)(\?.*)?$/i.test(src);
const embed = isLocal ? null : embedFor(src);
// The external-link card already shows the title, so the caption only repeats it for players.
const isPlayer = Boolean(embed) || isLocal || isFile;
const mime = src.match(/\.(webm|ogv)$/i) ? `video/${src.endsWith('ogv') ? 'ogg' : 'webm'}` : 'video/mp4';
---

<figure class="video">
  {
    embed ? (
      <div class="video__frame">
        <iframe
          src={embed}
          title={title}
          loading="lazy"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        />
      </div>
    ) : isLocal || isFile ? (
      <div class="video__frame">
        <video controls preload="metadata" playsinline poster={poster} aria-label={title}>
          <source src={src} type={mime} />
          <a href={src}>Download the video: {title}</a>
        </video>
      </div>
    ) : (
      <a href={src} class="video__link" target="_blank" rel="noopener noreferrer">
        <span class="video__play" aria-hidden="true">
          <Icon name="play" size={20} />
        </span>
        <span>
          <span class="video__link-title">{title}</span>
          <span class="mono video__link-note">
            Watch video <span class="visually-hidden">(opens in a new tab)</span>
          </span>
        </span>
        <Icon name="external" size={16} class="video__ext" />
      </a>
    )
  }
  {
    (isPlayer || caption) && (
      <figcaption>
        {isPlayer && <span class="video__title">{title}</span>}
        {caption && <span class="video__caption">{caption}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .video {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .video__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border);
    background: #0c0e0c;
  }

  .video__frame iframe,
  .video__frame video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: contain;
  }

  .video__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    text-decoration: none;
  }

  .video__link:hover {
    border-color: var(--accent);
  }

  .video__play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
  }

  .video__link-title {
    display: block;
    font-weight: 600;
  }

  .video__link-note {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .video__ext {
    color: var(--text-faint);
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-sm);
  }

  .video__title {
    color: var(--text);
    font-weight: 600;
  }

  .video__caption {
    color: var(--text-faint);
  }
</style>
