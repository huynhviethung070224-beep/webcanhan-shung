---
import { site, navRoutes } from '../config/site';
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
import { normalizePath } from '../utils/seo';

const current = normalizePath(Astro.url.pathname);
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label={`${site.displayName} — Home`}>
      <BrandMark size={30} />
      <span class="brand__name">
        <span class="brand__full">{site.fullName}</span>
        <span class="brand__nick serif">({site.nickname})</span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {
          navRoutes.map((route) => (
            <li>
              <a
                href={route.href}
                class:list={['nav__link', { 'is-active': isActive(route.href) }]}
                aria-current={isActive(route.href) ? 'page' : undefined}
              >
                {route.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      class="menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
      data-menu-open
    >
      <Icon name="menu" size={22} />
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden data-mobile-menu>
    <div class="mobile-menu__backdrop" data-menu-backdrop></div>
    <div class="mobile-menu__panel" role="dialog" aria-modal="true" aria-label="Site menu" tabindex="-1">
      <div class="mobile-menu__top">
        <span class="eyebrow eyebrow--plain">Menu</span>
        <button class="menu-btn menu-btn--close" type="button" aria-label="Close menu" data-menu-close>
          <Icon name="close" size={22} />
        </button>
      </div>
      <nav aria-label="Primary (mobile)">
        <ul class="mobile-menu__list">
          <li>
            <a href="/" class:list={['mobile-menu__link', { 'is-active': current === '/' }]} aria-current={current === '/' ? 'page' : undefined}>Home</a>
          </li>
          {
            navRoutes.map((route) => (
              <li>
                <a
                  href={route.href}
                  class:list={['mobile-menu__link', { 'is-active': isActive(route.href) }]}
                  aria-current={isActive(route.href) ? 'page' : undefined}
                >
                  {route.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="mobile-menu__foot mono">{site.displayName}</p>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-height);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(140%) blur(12px);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid var(--border);
    transition: background var(--dur-hover) var(--ease-out);
  }

  .site-header.is-scrolled {
    background: color-mix(in srgb, var(--bg) 97%, #000);
  }

  .site-header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    min-height: var(--control-height);
    color: var(--text);
  }

  .brand__name {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .brand__nick {
    font-size: 1.15em;
    color: var(--text-muted);
  }

  .nav {
    display: none;
  }

  .nav__list {
    display: flex;
    gap: var(--space-1);
    list-style: none;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-height-sm);
    padding: 0 0.85rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition:
      color var(--dur-hover) var(--ease-out),
      background var(--dur-hover) var(--ease-out);
  }

  .nav__link:hover {
    color: var(--text);
    background: var(--surface);
  }

  .nav__link.is-active {
    color: var(--text);
    position: relative;
  }

  .nav__link.is-active::after {
    content: '';
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    bottom: 4px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
  }

  .menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-height);
    height: var(--control-height);
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    color: var(--text);
    transition: border-color var(--dur-hover) var(--ease-out);
  }

  .menu-btn:hover {
    border-color: var(--accent);
  }

  @media (min-width: 900px) {
    .nav {
      display: block;
    }
    .menu-btn {
      display: none;
    }
  }

  /* Mobile menu */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(5, 6, 5, 0.6);
    animation: fade var(--dur-route) var(--ease-out);
  }

  .mobile-menu__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(100%, 360px);
    display: flex;
    flex-direction: column;
    padding: var(--space-4) var(--gutter) var(--space-6);
    background: var(--bg-elevated);
    border-left: 1px solid var(--border);
    overflow-y: auto;
    animation: slide var(--dur-route) var(--ease-out);
  }

  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: calc(var(--header-height) - var(--space-4) * 2);
  }

  .menu-btn--close {
    display: inline-flex;
  }

  .mobile-menu__list {
    list-style: none;
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }

  .mobile-menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    padding: 0 var(--space-2);
    border-bottom: 1px solid var(--border);
    font-size: var(--text-xl);
    font-weight: 500;
    text-decoration: none;
    color: var(--text);
  }

  .mobile-menu__link.is-active::after {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .mobile-menu__foot {
    margin-top: auto;
    padding-top: var(--space-6);
    color: var(--text-faint);
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  @keyframes slide {
    from {
      transform: translateX(24px);
      opacity: 0;
    }
  }
</style>

<script>
  function setupMenu() {
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (!header || header.dataset.menuReady) return;
    header.dataset.menuReady = 'true';

    const menu = header.querySelector<HTMLElement>('[data-mobile-menu]');
    const openBtn = header.querySelector<HTMLButtonElement>('[data-menu-open]');
    const closeBtn = header.querySelector<HTMLButtonElement>('[data-menu-close]');
    const backdrop = header.querySelector<HTMLElement>('[data-menu-backdrop]');
    const panel = menu?.querySelector<HTMLElement>('[role="dialog"]');
    if (!menu || !openBtn || !closeBtn || !panel) return;

    const focusable = () =>
      Array.from(
        panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'),
      );

    let lastFocused: HTMLElement | null = null;

    const open = () => {
      lastFocused = document.activeElement as HTMLElement | null;
      menu.hidden = false;
      openBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      (focusable()[0] ?? panel).focus();
      document.addEventListener('keydown', onKey);
    };

    const close = () => {
      menu.hidden = true;
      openBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKey);
      (lastFocused ?? openBtn).focus();
    };

    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
        return;
      }
      if (e.key === 'Tab') {
        const items = focusable();
        if (items.length === 0) return;
        const first = items[0]!;
        const last = items[items.length - 1]!;
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    };

    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    backdrop?.addEventListener('click', close);
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) close();
    });

    const mq = window.matchMedia('(min-width: 900px)');
    mq.addEventListener('change', () => {
      if (mq.matches && !menu.hidden) close();
    });
  }

  setupMenu();

  const scrolledHeader = document.querySelector<HTMLElement>('[data-header]');
  const onScroll = () => scrolledHeader?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  // Re-bind after bfcache restores.
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) {
      document.body.style.overflow = '';
    }
  });
</script>
