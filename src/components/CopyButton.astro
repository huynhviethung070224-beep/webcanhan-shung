---
/**
 * Copies `value` to the clipboard with visible success feedback.
 * If the clipboard is unavailable, the value is shown in a selected field with
 * manual-copy instructions. One delegated listener serves every instance, so it
 * keeps working after view transitions, back/forward cache restores and any
 * future client-side routing.
 */
import Icon from './Icon.astro';

interface Props {
  value: string;
  label: string;
  successLabel?: string;
  class?: string;
  variant?: 'btn' | 'icon';
  /** Copy the live `location.href` instead of `value` (keeps preview/dev URLs accurate). */
  useLocation?: boolean;
}

const { value, label, successLabel = 'Copied', class: className, variant = 'btn', useLocation = false } = Astro.props;
---

<span class:list={['copy', `copy--${variant}`, className]} data-copy>
  <button
    type="button"
    class:list={[variant === 'btn' ? 'btn btn--ghost btn--sm' : 'copy__icon']}
    data-copy-btn
    data-value={value}
    data-use-location={useLocation ? 'true' : undefined}
    data-label={label}
    data-success={successLabel}
    aria-label={variant === 'icon' ? label : undefined}
  >
    <Icon name="copy" size={16} class="copy__ico copy__ico--idle" />
    <Icon name="check" size={16} class="copy__ico copy__ico--done" />
    {variant === 'btn' && <span data-copy-text>{label}</span>}
  </button>
  <span class="visually-hidden" role="status" aria-live="polite" data-copy-status></span>
  <span class="copy__manual" hidden data-copy-manual>
    <input class="copy__fallback" type="text" readonly value={value} data-copy-fallback aria-label={`${label}: value to copy manually`} />
    <span class="copy__hint mono" data-copy-hint>Select and copy</span>
  </span>
</span>

<style>
  .copy {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    position: relative;
    max-width: 100%;
  }

  .copy__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-height);
    height: var(--control-height);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    transition:
      color var(--dur-hover) var(--ease-out),
      border-color var(--dur-hover) var(--ease-out);
  }

  .copy__icon:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .copy__ico--done {
    display: none;
  }

  .copy.is-done .copy__ico--idle {
    display: none;
  }

  .copy.is-done .copy__ico--done {
    display: inline-block;
    color: var(--accent);
  }

  .copy.is-done .btn,
  .copy.is-done .copy__icon {
    border-color: var(--accent);
    color: var(--accent);
  }

  .copy__manual {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    max-width: 100%;
  }

  .copy__manual[hidden] {
    display: none;
  }

  .copy__fallback {
    font: inherit;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.65rem;
    min-height: var(--control-height-sm);
    width: min(100%, 22rem);
  }

  .copy__hint {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
</style>

<script>
  import { bindOnce, onPageReady } from '../scripts/lifecycle';
  import { copyShortcut, copyText } from '../scripts/clipboard';

  const RESET_MS = 2200;
  const timers = new WeakMap<HTMLElement, number>();

  function reset(root: HTMLElement) {
    const btn = root.querySelector<HTMLButtonElement>('[data-copy-btn]');
    const text = root.querySelector<HTMLElement>('[data-copy-text]');
    const status = root.querySelector<HTMLElement>('[data-copy-status]');
    root.classList.remove('is-done');
    if (text && btn) text.textContent = btn.dataset.label ?? '';
    if (status) status.textContent = '';
  }

  async function handle(btn: HTMLButtonElement) {
    const root = btn.closest<HTMLElement>('[data-copy]');
    if (!root || btn.dataset.busy) return;
    const text = root.querySelector<HTMLElement>('[data-copy-text]');
    const status = root.querySelector<HTMLElement>('[data-copy-status]');
    const manual = root.querySelector<HTMLElement>('[data-copy-manual]');
    const fallback = root.querySelector<HTMLInputElement>('[data-copy-fallback]');
    const hint = root.querySelector<HTMLElement>('[data-copy-hint]');
    const value = btn.dataset.useLocation ? window.location.href : (btn.dataset.value ?? '');
    const success = btn.dataset.success ?? 'Copied';

    btn.dataset.busy = 'true';
    window.clearTimeout(timers.get(root));
    const ok = await copyText(value);
    delete btn.dataset.busy;

    if (ok) {
      if (manual) manual.hidden = true;
      root.classList.add('is-done');
      if (text) text.textContent = success;
      if (status) status.textContent = `${success}: ${value}`;
      timers.set(
        root,
        window.setTimeout(() => reset(root), RESET_MS),
      );
      return;
    }

    const instruction = `Copy is blocked here. Press ${copyShortcut()} to copy the selected text.`;
    if (fallback) fallback.value = value;
    if (hint) hint.textContent = `Press ${copyShortcut()}`;
    if (manual) manual.hidden = false;
    if (status) status.textContent = instruction;
    fallback?.focus();
    fallback?.select();
  }

  bindOnce('copy-button', () => {
    document.addEventListener('click', (event) => {
      const btn = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-copy-btn]');
      if (btn) void handle(btn);
    });
    document.addEventListener('focusin', (event) => {
      const input = event.target as HTMLElement | null;
      if (input instanceof HTMLInputElement && input.matches('[data-copy-fallback]')) input.select();
    });
  });

  onPageReady(({ restored }) => {
    if (!restored) return;
    document.querySelectorAll<HTMLElement>('[data-copy]').forEach((root) => {
      reset(root);
      const manual = root.querySelector<HTMLElement>('[data-copy-manual]');
      if (manual) manual.hidden = true;
    });
  });
</script>
