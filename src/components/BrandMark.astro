---
/**
 * Small typographic brand mark: an "I" and "H" joined by an orbit arc.
 * The same geometry is used for the favicon in public/favicon.svg.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<svg
  class:list={['brand-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <rect width="32" height="32" rx="8" fill="var(--bg-elevated)" stroke="var(--border)"></rect>
  <path d="M9.5 9v14" stroke="var(--text)" stroke-width="2.4" stroke-linecap="round"></path>
  <path d="M15.5 9v14M22.5 9v14M15.5 16h7" stroke="var(--text)" stroke-width="2.4" stroke-linecap="round"></path>
  <path
    d="M6.5 22.5c3.5 5.5 15.5 5.5 19-.5"
    stroke="var(--accent)"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-dasharray="2 3"></path>
  <circle cx="25.5" cy="22" r="1.8" fill="var(--accent)"></circle>
</svg>
