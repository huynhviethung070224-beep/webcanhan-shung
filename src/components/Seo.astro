---
import { site } from '../config/site';
import { absoluteUrl, pageTitle, ogImagePath } from '../utils/seo';

interface Props {
  title?: string;
  description?: string;
  /** Key of the generated OG image (see src/pages/og/[...key].png.ts). Defaults to "home". */
  ogKey?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  ogKey = 'home',
  type = 'website',
  publishedAt,
  updatedAt,
  noindex = false,
} = Astro.props;

const fullTitle = pageTitle(title);
const canonical = absoluteUrl(Astro.url.pathname, Astro.site);
const ogImage = absoluteUrl(ogImagePath(ogKey), Astro.site);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:site_name" content={site.displayName} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title ?? site.displayName} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.displayName} — ${title ?? site.tagline}`} />
{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? site.displayName} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
