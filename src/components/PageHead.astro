---
/** Compact page header for secondary pages (not the Home hero). */
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  /** Visual size of the title. */
  size?: 'md' | 'lg';
}
const { eyebrow, title, lead, size = 'lg' } = Astro.props;
---

<header class:list={['page-head', `page-head--${size}`]}>
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="page-head__title">{title}</h1>
    {lead && <p class="page-head__lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-head {
    padding-block: clamp(3rem, 8vh, 6rem) clamp(2.5rem, 6vh, 4rem);
    border-bottom: 1px solid var(--border);
  }

  .page-head__title {
    margin-top: var(--space-4);
    font-size: var(--text-3xl);
    font-weight: 500;
    letter-spacing: -0.03em;
    max-width: 20ch;
  }

  .page-head--lg .page-head__title {
    font-size: clamp(2.5rem, 1.6rem + 4vw, 4.5rem);
  }

  .page-head__lead {
    margin-top: var(--space-5);
    max-width: 60ch;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .page-head > .container > * {
      animation: rise 500ms var(--ease-out) both;
    }
    .page-head > .container > :nth-child(2) {
      animation-delay: 50ms;
    }
    .page-head > .container > :nth-child(3) {
      animation-delay: 110ms;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
</style>
