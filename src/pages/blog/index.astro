---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, formatDate, readingTime } from '../../utils/content';

const posts = await getPosts();
const title = 'Blog';
const description =
  'Articles by Huynh Viet Hung (Ian) about learning, data, software, project decisions, and internship reflections.';
---

<BaseLayout title={title} description={description} ogKey="blog">
  <PageHead
    eyebrow="Blog"
    title="Notes on learning, data, and software."
    lead="Writing about what I learn from real projects: data, software decisions, and internship reflections."
    size="md"
  />

  <section class="section">
    <div class="container">
      {
        posts.length === 0 ? (
          <div class="empty reveal">
            <p class="eyebrow eyebrow--plain">Nothing published yet</p>
            <h2 class="empty__title">The first article is still being written.</h2>
            <p class="muted empty__text">
              When it’s ready it will appear here with its date, a short description, and reading time. In the
              meantime, the projects are the best place to see what I’ve been working on.
            </p>
            <div class="empty__actions">
              <a href="/projects" class="btn btn--primary">
                View Projects <Icon name="arrow-right" size={18} class="arrow" />
              </a>
              <a href="/" class="btn btn--ghost">Back to Home</a>
            </div>
          </div>
        ) : (
          <ol class="posts">
            {posts.map((post, i) => (
              <li class="post reveal" style={`--reveal-delay:${Math.min(i, 5) * 60}ms`}>
                <a href={`/blog/${post.id}`} class="post__link">
                  <p class="post__meta mono">
                    <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
                    <span aria-hidden="true">·</span>
                    <span>{readingTime(post.body).minutes} min read</span>
                  </p>
                  <h2 class="post__title">
                    {post.data.title} <Icon name="arrow-right" size={20} class="arrow" />
                  </h2>
                  <p class="post__desc muted">{post.data.description}</p>
                  {post.data.tags.length > 0 && (
                    <ul class="tags" aria-label="Tags">
                      {post.data.tags.map((t) => (
                        <li class="tag">{t}</li>
                      ))}
                    </ul>
                  )}
                </a>
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .empty {
    max-width: var(--prose-width);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
  }

  .empty__title {
    font-size: var(--text-2xl);
    font-weight: 500;
  }

  .empty__text {
    line-height: var(--leading-relaxed);
  }

  .empty__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .posts {
    list-style: none;
    max-width: calc(var(--prose-width) + 8rem);
    border-top: 1px solid var(--border);
  }

  .post {
    border-bottom: 1px solid var(--border);
  }

  .post__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-block: var(--space-6);
    text-decoration: none;
  }

  .post__meta {
    display: flex;
    gap: var(--space-2);
    color: var(--text-muted);
  }

  .post__title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-2xl);
    font-weight: 500;
  }

  .post__title .arrow {
    color: var(--accent);
    transition: transform var(--dur-hover) var(--ease-out);
  }

  .post__link:hover .post__title {
    color: var(--accent);
  }

  .post__link:hover .arrow {
    transform: translateX(4px);
  }

  .post__desc {
    max-width: 60ch;
  }
</style>
