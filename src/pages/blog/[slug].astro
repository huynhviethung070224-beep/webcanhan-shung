---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getPublishedPosts, getRelatedPosts } from '../../utils/content';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => {
    const related = getRelatedPosts(post, posts);
    return { params: { slug: post.id }, props: { post, related } };
  });
}

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
---

<ArticleLayout post={post} headings={headings} related={related}>
  <Content />
</ArticleLayout>
