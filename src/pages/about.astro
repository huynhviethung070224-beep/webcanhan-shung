---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import Portrait from '../components/Portrait.astro';
import Availability from '../components/Availability.astro';
import { site } from '../config/site';

const title = 'About Me';
const description = `${site.displayName} is a Data Science student at Drexel University from Vietnam, interested in data, software development, and AI.`;
const byOrder = <T extends { order: number }>(items: readonly T[]) => [...items].sort((a, b) => a.order - b.order);
const timelineGroups = [
  { id: 'tl-education', label: 'Education', entries: byOrder(site.education) },
  { id: 'tl-work', label: 'Work experience', entries: byOrder(site.workExperience) },
  { id: 'tl-leadership', label: 'Leadership & activities', entries: byOrder(site.leadership) },
].filter((group) => group.entries.length > 0);
---

<BaseLayout title={title} description={description} ogKey="about">
  <PageHead
    eyebrow="About Me"
    title="The person behind the work."
    lead={`${site.displayName} — ${site.facts.program} student at ${site.facts.school}, originally from ${site.facts.origin}.`}
  />

  <section class="section">
    <div class="container about">
      <div class="about__visual reveal">
        <Portrait loading="eager" />
        <Availability class="about__availability" />
        <dl class="about__facts">
          <div>
            <dt class="mono">Studying</dt>
            <dd>{site.facts.program}, {site.facts.school}</dd>
          </div>
          <div>
            <dt class="mono">From</dt>
            <dd>{site.facts.origin}</dd>
          </div>
          <div>
            <dt class="mono">Interested in</dt>
            <dd>{site.facts.interests.join(', ')}</dd>
          </div>
          <div>
            <dt class="mono">Skills</dt>
            <dd>{site.facts.linkedInSkills.join(', ')}</dd>
          </div>
        </dl>
      </div>

      <div class="about__narrative">
        <section class="about__block reveal" aria-labelledby="bg-title">
          <h2 id="bg-title">Background</h2>
          <p>
            I’m {site.displayName}, a {site.facts.program} student at {site.facts.school}. I’m from {site.facts.origin},
            and I’m interested in data, software development, and AI.
          </p>
          <p>
            I like turning ideas into working applications and exploring how technology can solve practical problems.
            Through my projects and internship experience, I’m building technical skills alongside an understanding of
            how businesses work.
          </p>
        </section>

        <section class="about__block reveal" aria-labelledby="work-title">
          <h2 id="work-title">How I work</h2>
          <p>
            On <a href="/projects/dragon-go">DragonGo</a> I built backend and database functionality: Firebase
            Authentication and synchronized per-user schedules and account data. On the{' '}
            <a href="/projects/library-management-system">Library Management System</a> I designed a normalized
            PostgreSQL schema and wrote the SQL reports on top of it. The same SQL practice shows up in{' '}
            <a href="/projects/retail-sales-analysis">retail sales analysis</a>.{' '}
            <a href="/projects/badminton-fairplay-queue">Badminton FairPlay Queue</a> is a club app for fair court
            assignment.
          </p>
          <p>
            AI is an interest and part of the documented DragonGo product (AI-assisted scheduling); data and software
            development are where I’ve done the hands-on work.
          </p>
        </section>

        <section class="about__block reveal" aria-labelledby="timeline-title">
          <h2 id="timeline-title">Education, experience, and leadership</h2>
          {
            timelineGroups.map((group) => (
              <div class="timeline-group">
                <h3 id={group.id} class="timeline-group__title mono">
                  {group.label}
                </h3>
                <ol class="timeline">
                  {group.entries.map((item) => (
                    <li class="timeline__item">
                      <span class="timeline__marker" aria-hidden="true" />
                      <div>
                        <p class="timeline__head">
                          <span class="timeline__title">
                            {item.title} · {item.organization}
                          </span>
                          {item.period && <span class="mono muted">{item.period}</span>}
                        </p>
                        {item.location && <p class="muted timeline__loc">{item.location}</p>}
                        {item.description && <p class="muted">{item.description}</p>}
                      </div>
                    </li>
                  ))}
                </ol>
              </div>
            ))
          }
          <a href="/portfolio" class="textlink timeline__more">
            Details, contributions, and evidence on Portfolio <Icon name="arrow-right" size={16} class="arrow" />
          </a>
        </section>

        <section class="about__block reveal" aria-labelledby="beyond-title">
          <h2 id="beyond-title">Beyond the screen</h2>
          <p>When I’m not at a keyboard, you’ll probably find me on a court or a course.</p>
          <ul class="hobbies" aria-label="Interests">
            {site.facts.hobbies.map((hobby) => <li class="hobby">{hobby}</li>)}
          </ul>
        </section>

        <div class="about__links reveal">
          <a href="/portfolio" class="btn btn--primary">
            Professional overview <Icon name="arrow-right" size={18} class="arrow" />
          </a>
          <a href="/contact" class="btn btn--ghost">Contact</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 900px) {
    .about {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-9);
      align-items: start;
    }
    .about__visual {
      position: sticky;
      top: calc(var(--header-height) + var(--space-6));
    }
  }

  :global(.about__availability) {
    margin-top: var(--space-5);
  }

  .about__facts {
    margin-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .about__facts > div {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border);
    font-size: var(--text-sm);
  }

  .about__facts dt {
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    font-size: var(--text-xs);
    padding-top: 0.25em;
  }

  .about__narrative {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: var(--prose-width);
  }

  .about__block {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .about__block h2 {
    font-size: var(--text-2xl);
    font-weight: 500;
  }

  .about__block p {
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  .about__block a:not(.btn):not(.textlink) {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent-line);
  }

  .about__block a:not(.btn):not(.textlink):hover {
    color: var(--accent);
  }

  .timeline-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .timeline-group__title {
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--text-faint);
  }

  .timeline__loc {
    font-size: var(--text-sm);
  }

  .timeline__more {
    font-size: var(--text-sm);
    margin-top: var(--space-2);
  }

  .timeline {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-top: var(--space-2);
  }

  .timeline__item {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: var(--space-4);
    position: relative;
  }

  .timeline__item:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 9px;
    top: 20px;
    bottom: calc(-1 * var(--space-5));
    width: 1px;
    background: var(--border);
  }

  .timeline__marker {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    display: grid;
    place-items: center;
    margin-top: 2px;
  }

  .timeline__marker::after {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .timeline__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    color: var(--text);
  }

  .timeline__title {
    font-weight: 600;
  }

  .hobbies {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .hobby {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 0.9rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    text-transform: capitalize;
    font-size: var(--text-sm);
  }

  .about__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
