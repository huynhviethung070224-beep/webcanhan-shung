---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import FilterBar from '../../components/FilterBar.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../config/site';
import { getProjects, projectSearchText } from '../../utils/content';
import { facetOptions } from '../../utils/filters';
import { countWord, listJoin, plural } from '../../utils/format';

const projects = await getProjects();
const primary = projects.filter((project) => !project.data.earlier);
const earlier = projects.filter((project) => project.data.earlier);
const title = 'Projects';
const description = `Projects by ${site.displayName}: ${listJoin(projects.map((p) => p.data.title))}.`;
const lead = [
  `${countWord(primary.length, true)} ${plural(primary.length, 'case study', 'case studies')} with a role, a stack, and what I actually built.`,
  earlier.length > 0 ? `Earlier practice ${plural(earlier.length, 'sits', 'sit')} below.` : '',
]
  .filter(Boolean)
  .join(' ');

const facets = [
  { name: 'category', label: 'Category', options: facetOptions(projects.map((p) => (p.data.category ? [p.data.category] : []))) },
  { name: 'tech', label: 'Technology', options: facetOptions(projects.map((p) => p.data.technologies)) },
];
const filterAttrs = (project: (typeof projects)[number]) => ({
  'data-filter-item': 'projects',
  'data-filter-text': projectSearchText(project),
  'data-filter-category': project.data.category ?? '',
  'data-filter-tech': project.data.technologies.join('|'),
});
---

<BaseLayout title={title} description={description} ogKey="projects">
  <PageHead eyebrow="Projects" title="Products and technical case studies." lead={lead} />

  <section class="section" aria-label="All projects">
    <div class="container">
      {
        projects.length > 1 && (
          <div class="filters-wrap">
            <FilterBar
              scope="projects"
              searchLabel="Search projects"
              placeholder="Title, role, or technology"
              facets={facets}
              noun={{ one: 'project', many: 'projects' }}
              total={projects.length}
            />
          </div>
        )
      }

      <div class="empty-state no-match" data-filter-empty="projects" hidden>
        <p class="empty-state__title">No projects match these filters.</p>
        <p class="muted">Try a different word or technology, or clear the filters to see every project.</p>
        <button type="button" class="btn btn--ghost btn--sm" data-filter-reset="projects">Reset filters</button>
      </div>

      <ol class="list" data-filter-group="projects">
        {
          primary.map((project, i) => (
            <li class="list__item reveal" style={`--reveal-delay:${Math.min(i, 3) * 80}ms`} {...filterAttrs(project)}>
              <ProjectCard project={project} index={i} layout="feature" headingLevel="h2" loading={i === 0 ? 'eager' : 'lazy'} />
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    earlier.length > 0 && (
      <section class="section earlier" aria-labelledby="earlier-title" data-filter-group="projects">
        <div class="container">
          <p class="eyebrow">Earlier practice</p>
          <h2 id="earlier-title" class="earlier__title">Before the larger projects</h2>
          <ul class="earlier__list">
            {earlier.map((project) => (
              <li {...filterAttrs(project)}>
                <a href={`/projects/${project.id}`} class="earlier__link">
                  <span class="earlier__name">
                    {project.data.title}
                    <Icon name="arrow-right" size={16} class="arrow" />
                  </span>
                  <span class="mono muted">{project.data.role}</span>
                  <span class="earlier__tag muted">{project.data.tagline}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .filters-wrap {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .no-match {
    margin-bottom: var(--space-7);
  }

  .list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .list__item {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--border);
  }

  .list__item:first-child {
    padding-top: 0;
  }

  .list__item:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .earlier {
    padding-top: 0;
  }

  .earlier__title {
    margin-top: var(--space-3);
    font-size: var(--text-xl);
    font-weight: 500;
  }

  .earlier__list {
    list-style: none;
    margin-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .earlier__link {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border);
    text-decoration: none;
  }

  @media (min-width: 720px) {
    .earlier__link {
      grid-template-columns: minmax(12rem, 18rem) 10rem 1fr;
      gap: var(--space-5);
      align-items: baseline;
    }
  }

  .earlier__name {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
  }

  .earlier__name .arrow {
    color: var(--accent);
    transition: transform var(--dur-hover) var(--ease-out);
  }

  .earlier__link:hover .earlier__name {
    color: var(--accent);
  }

  .earlier__link:hover .arrow {
    transform: translateX(3px);
  }

  .earlier__tag {
    font-size: var(--text-sm);
  }
</style>
