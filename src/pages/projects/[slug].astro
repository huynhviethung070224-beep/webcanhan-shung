---
import { render } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import Lightbox from '../../components/Lightbox.astro';
import Gallery from '../../components/Gallery.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import ResultBlock from '../../components/ResultBlock.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import Icon from '../../components/Icon.astro';
import { getProjects } from '../../utils/content';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
const hasNext = next && next.id !== project.id;

const videos = data.media.filter((m) => m.type === 'video');
const mediaImages = data.media.filter((m) => m.type === 'image');
const outcomes = data.outcomes ?? [];
const analysis = data.analysis;

const resourceLabels: Record<(typeof data.resources)[number]['type'], string> = {
  documentation: 'Documentation',
  notebook: 'Notebook',
  dataset: 'Dataset',
  report: 'Report',
  other: 'Link',
};

const section = (slug: string, text: string): MarkdownHeading => ({ depth: 2, slug, text });
const before: MarkdownHeading[] = [
  ...(data.media.length > 0 ? [section('project-demo', videos.length > 0 ? 'Demo' : 'Media')] : []),
  ...(analysis ? [section('project-analysis', 'Analysis at a glance')] : []),
];
const after: MarkdownHeading[] = [
  ...(data.results.length > 0 ? [section('project-results', 'Results')] : []),
  ...(outcomes.length > 0 ? [section('project-outcomes', 'Outcomes')] : []),
  ...(data.challenges.length > 0 ? [section('project-challenges', 'Challenges')] : []),
  ...(data.lessonsLearned.length > 0 ? [section('project-lessons', 'Lessons learned')] : []),
  ...(data.gallery.length > 0 ? [section('project-gallery', 'Evidence')] : []),
  ...(data.resources.length > 0 ? [section('project-resources', 'Resources')] : []),
];
const tocHeadings = [...before, ...headings, ...after];
const facts = [
  { label: 'Purpose', value: data.purpose },
  { label: 'Role', value: data.role },
  { label: 'Category', value: data.category },
  { label: 'Stack', value: data.technologies.join(', ') },
  { label: 'When', value: data.period },
  { label: 'Team', value: data.teamSize },
  { label: 'Status', value: data.status },
].filter((fact): fact is { label: string; value: string } => Boolean(fact.value));
---

<BaseLayout title={data.title} description={data.summary} ogKey={`projects/${project.id}`}>
  <article class="case">
    <header class="case__head">
      <div class="container">
        <a href="/projects" class="textlink back">
          <Icon name="arrow-left" size={16} class="arrow" /> Back to Projects
        </a>
        <p class="eyebrow case__eyebrow">
          {data.role}
          {data.category && <span class="case__category">· {data.category}</span>}
        </p>
        <h1 class="case__title">{data.title}</h1>
        <p class="case__tagline">{data.tagline}</p>
        <ul class="tags case__tags" aria-label="Technologies">
          {data.technologies.map((t) => <li class="tag">{t}</li>)}
        </ul>
        {
          (data.demoUrl || data.repoUrl || videos.length > 0) && (
            <div class="case__actions">
              {data.demoUrl && (
                <ExternalLink href={data.demoUrl} class="btn btn--primary btn--sm">
                  Live Demo <Icon name="external" size={16} />
                </ExternalLink>
              )}
              {videos.length > 0 && (
                <a href="#project-demo" class:list={['btn btn--sm', data.demoUrl ? 'btn--ghost' : 'btn--primary']}>
                  <Icon name="play" size={16} /> Watch demo video
                </a>
              )}
              {data.repoUrl && (
                <ExternalLink href={data.repoUrl} class="btn btn--ghost btn--sm">
                  View Code <Icon name="external" size={16} />
                </ExternalLink>
              )}
            </div>
          )
        }
        {
          data.demoStatus && (
            <p class="demo-note">
              <Icon name="info" size={18} />
              <span>
                <span class="demo-note__label">Demo note</span> {data.demoStatus}
              </span>
            </p>
          )
        }
      </div>
    </header>

    <div class="container">
      <div class="case__cover">
        <ProjectCover variant={data.cover} title={data.title} alt={data.coverAlt} image={data.coverImage} fit={data.coverFit} frame={data.coverFrame} size="hero" loading="eager" />
      </div>
    </div>

    <div class="container case__body">
      <aside class="case__aside">
        <dl class="overview">
          {
            facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>
        <div class="case__toc">
          <TableOfContents headings={tocHeadings} min={3} label="In this case study" />
        </div>
      </aside>

      <div class="case__content">
        <section class="summary" aria-label="Summary">
          <p class="lead">{data.summary}</p>
        </section>

        <TableOfContents headings={tocHeadings} min={3} label="In this case study" variant="inline" />

        {
          data.media.length > 0 && (
            <section class="block" aria-labelledby="project-demo">
              <h2 id="project-demo" class="block__title">{videos.length > 0 ? 'Demo' : 'Media'}</h2>
              {videos.map((video) => (
                <VideoEmbed src={video.src} title={video.title} caption={video.caption} poster={video.poster} />
              ))}
              {mediaImages.length > 0 && <Gallery items={mediaImages} group={`${project.id}-media`} frameLabel={data.title} />}
            </section>
          )
        }

        {
          analysis && (
            <section class="block" aria-labelledby="project-analysis">
              <h2 id="project-analysis" class="block__title">Analysis at a glance</h2>
              <dl class="analysis">
                <div class="analysis__row analysis__row--wide">
                  <dt>Question</dt>
                  <dd class="analysis__question">{analysis.question}</dd>
                </div>
                <div class="analysis__row">
                  <dt>Data sources</dt>
                  <dd>
                    <ul>{analysis.dataSources.map((item) => <li>{item}</li>)}</ul>
                  </dd>
                </div>
                <div class="analysis__row">
                  <dt>Methods</dt>
                  <dd>
                    <ul>{analysis.methods.map((item) => <li>{item}</li>)}</ul>
                  </dd>
                </div>
                {analysis.findings.length > 0 && (
                  <div class="analysis__row">
                    <dt>Findings</dt>
                    <dd>
                      <ul>{analysis.findings.map((item) => <li>{item}</li>)}</ul>
                    </dd>
                  </div>
                )}
                {analysis.limitations.length > 0 && (
                  <div class="analysis__row">
                    <dt>Limitations</dt>
                    <dd>
                      <ul>{analysis.limitations.map((item) => <li>{item}</li>)}</ul>
                    </dd>
                  </div>
                )}
              </dl>
              {analysis.charts.length > 0 && <Gallery items={analysis.charts} group={`${project.id}-charts`} layout="wide" />}
            </section>
          )
        }

        <div class="prose">
          <Content />
        </div>

        {
          data.results.length > 0 && (
            <section class="block" aria-labelledby="project-results">
              <h2 id="project-results" class="block__title">Results</h2>
              {data.results.map((result, i) => (
                <ResultBlock result={result} group={`${project.id}-result-${i}`} />
              ))}
            </section>
          )
        }

        {
          outcomes.length > 0 && (
            <section class="block" aria-labelledby="project-outcomes">
              <h2 id="project-outcomes" class="block__title">Outcomes</h2>
              <ul class="bullets">
                {outcomes.map((o) => (
                  <li>{o}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          data.challenges.length > 0 && (
            <section class="block" aria-labelledby="project-challenges">
              <h2 id="project-challenges" class="block__title">Challenges</h2>
              <ul class="bullets">
                {data.challenges.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          data.lessonsLearned.length > 0 && (
            <section class="block" aria-labelledby="project-lessons">
              <h2 id="project-lessons" class="block__title">Lessons learned</h2>
              <ul class="bullets">
                {data.lessonsLearned.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </div>

    {
      data.gallery.length > 0 && (
        <div class="container">
          <section class="evidence" aria-labelledby="project-gallery">
            <h2 id="project-gallery" class="block__title">Evidence</h2>
            <Gallery items={data.gallery} group={`${project.id}-gallery`} frameLabel={data.title} />
          </section>
        </div>
      )
    }

    {
      data.resources.length > 0 && (
        <div class="container">
          <section class="resources" aria-labelledby="project-resources">
            <h2 id="project-resources" class="block__title">Resources</h2>
            <ul class="resources__list">
              {data.resources.map((resource) => (
                <li>
                  <ExternalLink href={resource.url} class="resource">
                    <span class="resource__type mono">{resourceLabels[resource.type]}</span>
                    <span class="resource__label">{resource.label}</span>
                    <Icon name={resource.url.startsWith('/') ? 'file' : 'external'} size={16} class="resource__icon" />
                  </ExternalLink>
                </li>
              ))}
            </ul>
          </section>
        </div>
      )
    }

    <footer class="case__foot">
      <div class="container case__foot-inner">
        <a href="/projects" class="textlink">
          <Icon name="arrow-left" size={16} class="arrow" /> Back to Projects
        </a>
        {
          hasNext && (
            <a href={`/projects/${next.id}`} class="next">
              <span class="eyebrow eyebrow--plain">Next project</span>
              <span class="next__title">
                {next.data.title} <Icon name="arrow-right" size={20} class="arrow" />
              </span>
            </a>
          )
        }
      </div>
    </footer>
  </article>
  <Lightbox />
  <script>
    import '../../scripts/prose-enhance';
  </script>
</BaseLayout>

<style>
  .case__head {
    padding-block: clamp(2.5rem, 6vh, 4.5rem) clamp(2rem, 4vh, 3rem);
  }

  .back {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .back .arrow {
    transition: transform var(--dur-hover) var(--ease-out);
  }

  .back:hover .arrow {
    transform: translateX(-3px);
  }

  .case__eyebrow {
    display: flex;
    flex-wrap: wrap;
    margin-top: var(--space-6);
  }

  .case__category {
    color: var(--text-faint);
  }

  .case__title {
    margin-top: var(--space-3);
    font-size: clamp(2.5rem, 1.6rem + 4vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }

  .case__tagline {
    margin-top: var(--space-4);
    max-width: 52ch;
    font-size: var(--text-lg);
    color: var(--text-muted);
  }

  .case__tags {
    margin-top: var(--space-5);
  }

  .case__actions {
    margin-top: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .case__actions .btn {
    min-height: var(--control-height);
  }

  .demo-note {
    margin-top: var(--space-4);
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    max-width: 60ch;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-left: 2px solid var(--accent);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .demo-note :global(svg) {
    color: var(--accent);
    margin-top: 1px;
  }

  .demo-note__label {
    color: var(--text);
    font-weight: 600;
  }

  .case__cover {
    max-width: var(--content-width);
  }

  .case__body {
    display: grid;
    gap: var(--space-7);
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  @media (min-width: 960px) {
    .case__body {
      grid-template-columns: 280px minmax(0, 1fr);
      gap: var(--space-9);
      align-items: start;
    }
    .case__aside {
      position: sticky;
      top: calc(var(--header-height) + var(--space-6));
    }
  }

  .overview {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    font-size: var(--text-sm);
  }

  .overview dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--text-faint);
    margin-bottom: var(--space-1);
  }

  .overview dd {
    color: var(--text);
  }

  .case__toc {
    margin-top: var(--space-6);
  }

  .case__content {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
    max-width: var(--prose-width);
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
  }

  .block__title {
    font-size: var(--text-2xl);
    font-weight: 500;
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
  }

  .bullets {
    padding-left: 1.3em;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    line-height: var(--leading-relaxed);
  }

  .bullets li::marker {
    color: var(--accent);
  }

  .analysis {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
  }

  @media (min-width: 640px) {
    .analysis {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .analysis__row--wide {
      grid-column: 1 / -1;
    }
  }

  .analysis dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--text-faint);
    margin-bottom: var(--space-2);
  }

  .analysis dd {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .analysis ul {
    padding-left: 1.1em;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .analysis__question {
    color: var(--text) !important;
    font-size: var(--text-lg) !important;
  }

  .evidence,
  .resources {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .resources__list {
    list-style: none;
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 720px) {
    .resources__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .resources__list :global(.resource) {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
    min-height: 64px;
    padding: var(--space-3) var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    text-decoration: none;
  }

  .resources__list :global(.resource:hover) {
    border-color: var(--accent);
  }

  .resources__list :global(.resource__type) {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--text-faint);
  }

  .resources__list :global(.resource__label) {
    font-weight: 600;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .resources__list :global(.resource__icon) {
    color: var(--text-faint);
  }

  .case__foot {
    border-top: 1px solid var(--border);
    padding-block: var(--space-7);
  }

  .case__foot-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .next {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-decoration: none;
    text-align: right;
    margin-left: auto;
  }

  .next__title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
  }

  .next__title .arrow {
    color: var(--accent);
    transition: transform var(--dur-hover) var(--ease-out);
  }

  .next:hover .next__title {
    color: var(--accent);
  }

  .next:hover .arrow {
    transform: translateX(4px);
  }
</style>
