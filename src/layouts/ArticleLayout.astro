---
/**
 * Reading layout for blog articles: metadata, optional cover, desktop table of
 * contents, reading-progress indicator, copy-link action and Back to Blog.
 */
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import CopyButton from '../components/CopyButton.astro';
import Lightbox from '../components/Lightbox.astro';
import Icon from '../components/Icon.astro';
import { formatDate, readingTime } from '../utils/content';
import { absoluteUrl } from '../utils/seo';
import '../styles/prose.css';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: MarkdownHeading[];
  related?: CollectionEntry<'blog'>[];
}

const { post, headings, related = [] } = Astro.props;
const { data } = post;
const time = readingTime(post.body);
const url = absoluteUrl(Astro.url.pathname, Astro.site);
---

<BaseLayout
  title={data.title}
  description={data.description}
  ogKey={`blog/${post.id}`}
  type="article"
  publishedAt={data.publishedAt}
  updatedAt={data.updatedAt}
>
  <div class="progress" aria-hidden="true"><div class="progress__bar" data-progress></div></div>

  <article class="article">
    <header class="article__head">
      <div class="container article__head-inner">
        <a href="/blog" class="textlink back">
          <Icon name="arrow-left" size={16} class="arrow" /> Back to Blog
        </a>
        <p class="article__meta mono">
          <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time>
          <span aria-hidden="true">·</span>
          <span>{time.minutes} min read</span>
          {
            data.updatedAt && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  Updated <time datetime={data.updatedAt.toISOString()}>{formatDate(data.updatedAt)}</time>
                </span>
              </>
            )
          }
        </p>
        <h1 class="article__title">{data.title}</h1>
        <p class="article__desc">{data.description}</p>
        {
          data.tags.length > 0 && (
            <ul class="tags" aria-label="Tags">
              {data.tags.map((t) => (
                <li class="tag">{t}</li>
              ))}
            </ul>
          )
        }
      </div>
    </header>

    {
      data.cover && (
        <div class="container">
          <figure class="article__cover">
            <img
              src={data.cover.src}
              alt={data.cover.alt}
              width={data.cover.width}
              height={data.cover.height}
              loading="eager"
              decoding="async"
            />
          </figure>
        </div>
      )
    }

    <div class="container article__body">
      <aside class="article__aside">
        <TableOfContents headings={headings} min={3} />
        <div class="article__actions">
          <CopyButton value={url} label="Copy article link" successLabel="Link copied" useLocation />
        </div>
      </aside>

      <div class="prose article__prose" data-article-content>
        <slot />
      </div>
    </div>

    <footer class="article__foot">
      <div class="container article__foot-inner">
        <a href="/blog" class="textlink">
          <Icon name="arrow-left" size={16} class="arrow" /> Back to Blog
        </a>
        <CopyButton value={url} label="Copy article link" successLabel="Link copied" useLocation />
      </div>
      {
        related.length > 0 && (
          <div class="container related">
            <p class="eyebrow">Related articles</p>
            <ul class="related__list">
              {related.map((r) => (
                <li>
                  <a href={`/blog/${r.id}`} class="related__link">
                    <span class="related__title">{r.data.title}</span>
                    <span class="mono muted">{formatDate(r.data.publishedAt)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </footer>
  </article>
  <Lightbox />

  <script>
    import '../scripts/prose-enhance';
  </script>
  <script>
    const bar = document.querySelector<HTMLElement>('[data-progress]');
    const content = document.querySelector<HTMLElement>('[data-article-content]');
    if (bar && content) {
      let ticking = false;
      const update = () => {
        const rect = content.getBoundingClientRect();
        const total = rect.height - window.innerHeight;
        const scrolled = Math.min(Math.max(-rect.top, 0), Math.max(total, 1));
        const pct = total > 0 ? (scrolled / total) * 100 : 100;
        bar.style.transform = `scaleX(${pct / 100})`;
        ticking = false;
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true },
      );
      update();
    }
  </script>
</BaseLayout>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 60;
    pointer-events: none;
  }

  .progress__bar {
    height: 100%;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0);
  }

  .article__head {
    padding-block: clamp(2.5rem, 6vh, 4.5rem) clamp(2rem, 4vh, 3rem);
  }

  .article__head-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: calc(var(--prose-width) + 280px + var(--space-9) + var(--gutter) * 2);
  }

  .back {
    font-size: var(--text-sm);
    color: var(--text-muted);
    align-self: flex-start;
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--text-muted);
    margin-top: var(--space-4);
  }

  .article__title {
    font-size: clamp(2rem, 1.4rem + 3vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    max-width: 24ch;
  }

  .article__desc {
    max-width: 60ch;
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  .article__cover img {
    width: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
  }

  .article__body {
    display: grid;
    gap: var(--space-7);
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
  }

  @media (min-width: 960px) {
    .article__body {
      grid-template-columns: minmax(0, var(--prose-width)) 240px;
      gap: var(--space-9);
      align-items: start;
    }
    .article__aside {
      order: 2;
      position: sticky;
      top: calc(var(--header-height) + var(--space-6));
    }
  }

  @media (max-width: 959px) {
    .article__aside :global(.toc) {
      display: none;
    }
  }

  .article__actions {
    margin-top: var(--space-5);
  }

  .article__prose {
    min-width: 0;
  }

  .article__foot {
    border-top: 1px solid var(--border);
    padding-block: var(--space-7);
  }

  .article__foot-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .related {
    margin-top: var(--space-7);
  }

  .related__list {
    list-style: none;
    margin-top: var(--space-4);
    border-top: 1px solid var(--border);
  }

  .related__link {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border);
    text-decoration: none;
  }

  .related__title {
    font-weight: 600;
  }

  .related__link:hover .related__title {
    color: var(--accent);
  }
</style>
